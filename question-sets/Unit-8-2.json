{"version":1,"name":"Ohio Grade 8 · 8.G unit review","difficulty":"advanced","pace":"practice","questions":[{"text":"A figure is reflected. A side was 22 cm. What is the new side length in cm?","answers":["44","22","23","21"],"correct":1,"explanation":"Rigid motions preserve lengths and angle measures.","topic":"Math","standard":"8.G.1","mathGrade":8,"mathLevel":"practice","mathFormat":"length-preserved","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 8 · Geometry","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=54","standardMeta":{"jurisdiction":"OH","code":"8.G.1","grade":8,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"length-preserved","coverageStatus":"Ready for teacher review","skillLabel":"Rigid-motion properties","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A figure is reflected. A marked angle was 104°. What is its new measure?","answers":["104","103","208","105"],"correct":0,"explanation":"Rigid motions preserve lengths and angle measures.","topic":"Math","standard":"8.G.1","mathGrade":8,"mathLevel":"practice","mathFormat":"angle-preserved","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 8 · Geometry","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=54","standardMeta":{"jurisdiction":"OH","code":"8.G.1","grade":8,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"angle-pr