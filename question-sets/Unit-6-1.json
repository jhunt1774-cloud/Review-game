ion":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"coordinates","points":[[-5,-4],[2,-4],[2,2],[-5,2]],"segments":[[0,1],[1,2],[2,3],[3,0]]},"format":"rectangle-side","coverageStatus":"Ready for teacher review","skillLabel":"Polygons on coordinate axes","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A rectangle has vertices (-2, -7), (4, -7), (4, -2), (-2, -2). Find its perimeter.","answers":["23","21","22","44"],"correct":2,"explanation":"Use coordinate differences for horizontal and vertical lengths.","topic":"Math","standard":"6.G.3","mathGrade":6,"mathLevel":"practice","mathFormat":"rectangle-perimeter","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Geometry","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.G.3","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"coordinates","points":[[-2,-7],[4,-7],[4,-2],[-2,-2]],"segments":[[0,1],[1,2],[2,3],[3,0]]},"format":"rectangle-perimeter","coverageStatus":"Ready for teacher review","skillLabel":"Polygons on coordinate axes","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A cube net has six square faces, each with side 5 cm. Find the total area in square cm.","answers":["151","150","300","149"],"correct":1,"explanation":"The net contains six faces, each of area side squared.","topic":"Math","standard":"6.G.4","mathGrade":6,"mathLevel":"practice","mathFormat":"cube-net","difficulty":"intermediate","generatorVersion