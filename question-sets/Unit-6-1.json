{"version":1,"name":"Ohio Grade 6 · 6.G unit review","difficulty":"advanced","pace":"practice","questions":[{"text":"A triangle has base 10 cm and perpendicular height 5 cm. Find its area in square cm.","answers":["25","24","50","26"],"correct":0,"explanation":"Use base × height ÷ 2.","topic":"Math","standard":"6.G.1","mathGrade":6,"mathLevel":"practice","mathFormat":"triangle","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Geometry","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.G.1","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"area","shape":"triangle","base":10,"height":5},"format":"triangle","coverageStatus":"Ready for teacher review","skillLabel":"Area by composition","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A parallelogram has base 18 cm and perpendicular height 5 cm. Find its area in square cm.","answers":["91","89","90","180"],"correct":2,"explanation":"Use base × perpendicular height.","topic":"Math","standard":"6.G.1","mathGrade":6,"mathLevel":"practice","mathFormat":"parallelogram","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Geometry","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.G.1","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program cont