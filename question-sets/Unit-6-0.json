riginal Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.4","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"like-terms","coverageStatus":"Ready for teacher review","skillLabel":"Recognize equivalent expressions","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Which x makes x + 5 = 19 true?","answers":["13","15","14","28"],"correct":2,"explanation":"Substitute and check both sides.","topic":"Math","standard":"6.EE.5","mathGrade":6,"mathLevel":"practice","mathFormat":"equation","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.5","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"equation","coverageStatus":"Ready for teacher review","skillLabel":"Check solutions by substitution","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Which value satisfies x > 3?","answers":["2","4","1","3"],"correct":1,"explanation":"The solution must be strictly greater than 3.","topic":"Math","standard":"6.EE.5","mathGrade":6,"mathLevel":"practice","mathFormat":"inequality","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.5","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"inequality","coverageStatus":"Ready for teacher review","skillLabel":"Check solutions by substitution","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Each kit costs $6. Which expression gives the cost of x kits?","answers":["6x + 1","6x","1x + 6","7x"],"correct":1,"explanation":"Multiply cost per kit by the number of kits.","topic":"Math","standard":"6.EE.6","mathGrade":6,"mathLevel":"practice","mathFormat":"unit-cost","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.6","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"unit-cost","coverageStatus":"Ready for teacher review","skillLabel":"Represent situations with variables","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A club pays $9 once and $11 per person. Which expression gives the cost for x people?","answers":["20x","11x + 10","11x + 9","9x + 11"],"correct":2,"explanation":"The fixed charge is added once; the per-person charge is multiplied by x.","topic":"Math","standard":"6.EE.6","mathGrade":6,"mathLevel":"practice","mathFormat":"fixed-plus-variable","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.6","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"fixed-plus-variable","coverageStatus":"Ready for teacher review","skillLabel":"Represent situations with variables","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Solve x + 6 = 8.","answers":["2","1","4","3"],"correct":0,"explanation":"Use the inverse operation and check the result.","topic":"Math","standard":"6.EE.7","mathGrade":6,"mathLevel":"practice","mathFormat":"addition","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.7","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"addition","coverageStatus":"Ready for teacher review","skillLabel":"Solve one-step equations","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Solve 8x = 8.","answers":["0","0.5","2","1"],"correct":3,"explanation":"Use the inverse operation and check the result.","topic":"Math","standard":"6.EE.7","mathGrade":6,"mathLevel":"practice","mathFormat":"multiplication","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.7","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"multiplication","coverageStatus":"Ready for teacher review","skillLabel":"Solve one-step equations","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"To solve x + 3 = 20, why should 3 be subtracted from both sides?","answers":["An operation is allowed on only the left side","It preserves equality while isolating x","Subtraction must always be used for every equation","It changes the value of x without changing the equation"],"correct":1,"explanation":"Applying the same operation to equal quantities keeps them equal.","topic":"Math","standard":"6.EE.7","mathGrade":6,"mathLevel":"practice","mathFormat":"balance-reasoning","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.7","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"balance-reasoning","coverageStatus":"Ready for teacher review","skillLabel":"Solve one-step equations","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A clu