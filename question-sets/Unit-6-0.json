th2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"coefficient","coverageStatus":"Ready for teacher review","skillLabel":"Write and evaluate expressions","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Expand 5(x + 5).","answers":["10x","5x + 26","5x + 25","5x + 5"],"correct":2,"explanation":"Multiply each term inside the parentheses by 5.","topic":"Math","standard":"6.EE.3","mathGrade":6,"mathLevel":"practice","mathFormat":"distribute","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.3","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"distribute","coverageStatus":"Ready for teacher review","skillLabel":"Generate equivalent expressions","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Combine like terms: 4x + 4x + 5.","answers":["4x + 9","8x + 6","16x + 5","8x + 5"],"correct":3,"explanation":"Add the coefficients of x; keep the constant.","topic":"Math","standard":"6.EE.3","mathGrade":6,"mathLevel":"practice","mathFormat":"combine-terms","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.3","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"combine-terms","coverageStatus":"Ready for teacher review","skillLabel":"Generate equivalent expressions","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A student rewrites 4(x + 5) as 4x + 5. What was missed?","answers":["The terms inside must be multiplied together","x must be replaced by 4","Only x should be multiplied","The 5 must also be multiplied by 4"],"correct":3,"explanation":"The outside factor multiplies every term in the sum.","topic":"Math","standard":"6.EE.3","mathGrade":6,"mathLevel":"practice","mathFormat":"explain-distribution","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=43","standardMeta":{"jurisdiction":"OH","code":"6.EE.3","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"explain-distribution","coverageStatus":"Ready for teacher review","skillLabel":"Generate equivalent expressions","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A rectangle is 3 units high and x + 3 units wide. Which expanded expression represents its area?","answers":["3x + 9","6x","3x + 3","1x + 9"],"correct":0,"explanation":"Multiply height by the entire width, then distribute.","topic":"Math","standard":"6.EE.3","mathGrade":6,"mathLevel":"practice","mathFormat":"area-expression","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Expressions and equations","sourc