inal Ohio middle-school practice","subject":"Grade 8 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=54","standardMeta":{"jurisdiction":"OH","code":"8.EE.8","grade":8,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"system","lines":[[2,7],[-2,7]],"intersection":[0,7]},"format":"intersection","coverageStatus":"Ready for teacher review","skillLabel":"Graphical systems of equations","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"The graphed lines are y = 2x − 3 and y = 2x + 1. How many solutions?","answers":["Infinitely many","Exactly two","Exactly one","No solutions"],"correct":3,"explanation":"Equal slopes and different intercepts give parallel lines.","topic":"Math","standard":"8.EE.8","mathGrade":8,"mathLevel":"practice","mathFormat":"parallel-lines","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 8 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=54","standardMeta":{"jurisdiction":"OH","code":"8.EE.8","grade":8,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"system","lines":[[2,-3],[2,1]]},"format":"parallel-lines","coverageStatus":"Ready for teacher review","skillLabel":"Graphical systems of equations","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"The graphed lines are y = 1x and y = 1x. How many solutions?","answers":["Infinitely many","Exactly two","Exactly one","No solutions"],"correct":0,"explanation":"The equations graph as the same line.","topic":"Math","standard":"8.EE.8","mathGrade":8,"mathLevel":"practice","mathFormat":"same-line","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 8 · Expressions and equations","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=54","standardMeta":{"jurisdiction":"OH","code":"8.EE.8","grade":8,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"system","lines":[[1,0],[1,0]]},"format":"same-line","coverageStatus":"Ready for teacher review","skillLabel":"Graphical systems of equations","contentSource":{"type":"prepared","label":"Saved generated practice"}}}]}