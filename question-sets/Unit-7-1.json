{"version":1,"name":"Ohio Grade 7 · 7.G unit review","difficulty":"advanced","pace":"practice","questions":[{"text":"A map uses 1 cm for 7 km. A route measures 5 cm. Find its real length in km.","answers":["35","70","34","36"],"correct":0,"explanation":"Lengths scale by the factor; areas scale by its square.","topic":"Math","standard":"7.G.1","mathGrade":7,"mathLevel":"practice","mathFormat":"length-scale","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 7 · Geometry","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=49","standardMeta":{"jurisdiction":"OH","code":"7.G.1","grade":7,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"length-scale","coverageStatus":"Ready for teacher review","skillLabel":"Scale drawings and similarity","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"A rectangular drawing measures 7 cm by 8 cm. Enlarge each length by a factor of 4. Find the new area in square cm.","answers":["896","895","897","1792"],"correct":0,"explanation":"Lengths scale by the factor; areas scale by its square.","topic":"Math","standard":"7.G.1","mathGrade":7,"mathLevel":"practice","mathFormat":"area-scale","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 7 · Geometry","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=49","standardMeta":{"jurisdiction":"OH","code":"7.G.1","grade":7,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring