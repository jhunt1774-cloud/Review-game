{"version":1,"name":"Ohio Grade 6 · 6.SP unit review","difficulty":"advanced","pace":"practice","questions":[{"text":"A class has 24 students. Which question anticipates varying numerical answers?","answers":["How old am I today?","How many minutes does each student travel to school?","What is 2 + 2?","What is the name of our school?"],"correct":1,"explanation":"A statistical question anticipates variability across observations.","topic":"Math","standard":"6.SP.1","mathGrade":6,"mathLevel":"practice","mathFormat":"statistical-question","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.1","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"statistical-question","coverageStatus":"Ready for teacher review","skillLabel":"Statistical questions and data plans","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"To study travel time for 36 classmates, what is the best data plan?","answers":["Use one student’s time for everyone","Ask only the teacher for their favorite color","Record the classroom wall color","Ask each classmate for travel time in minutes"],"correct":3,"explanation":"Collect quantitative data from the people named in the question.","topic":"Math","standard":"6.SP.1","mathGrade":6,"mathLevel":"practice","mathFormat":"collect-data","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.1","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"collect-data","coverageStatus":"Ready for teacher review","skillLabel":"Statistical questions and data plans","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Find the range of 18, 19, 19, 20, 34.","answers":["15","16","17","32"],"correct":1,"explanation":"Describe both the cluster and the spread; a distant value can affect the mean.","topic":"Math","standard":"6.SP.2","mathGrade":6,"mathLevel":"practice","mathFormat":"range","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.2","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"distribution","mode":"dot","values":[18,19,19,20,34]},"format":"range","coverageStatus":"Ready for teacher review","skillLabel":"Describe distributions","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Which value is farthest from the cluster near 21?","answers":["35","37","36","72"],"correct":2,"explanation":"Describe both the cluster and the spread; a distant value can affect the mean.","topic":"Math","standard":"6.SP.2","mathGrade":6,"mathLevel":"practice","mathFormat":"cluster-and-outlier","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.2","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"distribution","mode":"dot","values":[20,21,21,22,36]},"format":"cluster-and-outlier","coverageStatus":"Ready for teacher review","skillLabel":"Describe distributions","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"For the data 20, 27, 34, find the mean (a measure of center).","answers":["28","26","54","27"],"correct":3,"explanation":"Add the observations and divide by three.","topic":"Math","standard":"6.SP.3","mathGrade":6,"mathLevel":"practice","mathFormat":"mean","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.3","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"mean","coverageStatus":"Ready for teacher review","skillLabel":"Center versus variability","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"For the data 29, 34, 39, find the range (a measure of spread).","answers":["11","10","20","9"],"correct":1,"explanation":"Subtract the smallest observation from the largest.","topic":"Math","standard":"6.SP.3","mathGrade":6,"mathLevel":"practice","mathFormat":"range","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.3","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"range","coverageStatus":"Ready for teacher review","skillLabel":"Center versus variability","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"In the dot plot, how many observations equal 13?","answers":["4","3","2","6"],"correct":1,"explanation":"Each dot represents one observation.","topic":"Math","standard":"6.SP.4","mathGrade":6,"mathLevel":"practice","mathFormat":"dot-frequency","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.4","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"distribution","mode":"dot","values":[11,12,13,13,13,14,15,16]},"format":"dot-frequency","coverageStatus":"Ready for teacher review","skillLabel":"Read and construct numerical plots","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"The histogram uses bins [19, 21) and [21, 25). How many values are in the second bin?","answers":["12","5","6","7"],"correct":2,"explanation":"The left boundary is included and the right boundary is excluded.","topic":"Math","standard":"6.SP.4","mathGrade":6,"mathLevel":"practice","mathFormat":"histogram-count","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.4","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"distribution","mode":"hist","values":[19,20,21,21,21,22,23,24],"bins":[19,21,25]},"format":"histogram-count","coverageStatus":"Ready for teacher review","skillLabel":"Read and construct numerical plots","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"What median is marked in this box plot?","answers":["10","20","9","11"],"correct":0,"explanation":"The line inside the box marks the median.","topic":"Math","standard":"6.SP.4","mathGrade":6,"mathLevel":"practice","mathFormat":"box-median","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.4","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","mathModel":{"kind":"distribution","mode":"box","values":[8,9,10,10,10,11,12,13]},"format":"box-median","coverageStatus":"Ready for teacher review","skillLabel":"Read and construct numerical plots","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Find the median travel time for 21, 22, 23, 24, 26, 27, 28, 29.","answers":["24","50","26","25"],"correct":3,"explanation":"Average the fourth and fifth sorted observations.","topic":"Math","standard":"6.SP.5","mathGrade":6,"mathLevel":"practice","mathFormat":"median","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.5","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"median","coverageStatus":"Ready for teacher review","skillLabel":"Summarize data in context","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"For 24, 25, 26, 27, 29, 30, 31, 32, use medians of the lower and upper halves. Find the interquartile range.","answers":["4","10","6","5"],"correct":3,"explanation":"Q1 = 25.5 and Q3 = 30.5. Subtract Q1 from Q3.","topic":"Math","standard":"6.SP.5","mathGrade":6,"mathLevel":"practice","mathFormat":"interquartile-range","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.5","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"interquartile-range","coverageStatus":"Ready for teacher review","skillLabel":"Summarize data in context","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Travel times in minutes are 30, 31, 32, 33, 35, 36, 37, 38. How many observations are recorded?","answers":["9","16","8","7"],"correct":2,"explanation":"Count the data values, retaining their measurement units.","topic":"Math","standard":"6.SP.5","mathGrade":6,"mathLevel":"practice","mathFormat":"observation-count","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 6 · Statistics and probability","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=44","standardMeta":{"jurisdiction":"OH","code":"6.SP.5","grade":6,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"observation-count","coverageStatus":"Ready for teacher review","skillLabel":"Summarize data in context","contentSource":{"type":"prepared","label":"Saved generated practice"}}}]}