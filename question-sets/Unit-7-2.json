t","format":"signed-number-model","coverageStatus":"Ready for teacher review","skillLabel":"Add and subtract rational numbers","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Why does 5 − (−3) equal 8?","answers":["The 3 should be ignored","Two negative signs make every expression negative","Subtracting always moves left","Subtracting a negative is equivalent to adding its opposite"],"correct":3,"explanation":"On a number line, removing a negative displacement increases the value.","topic":"Math","standard":"7.NS.1","mathGrade":7,"mathLevel":"practice","mathFormat":"subtract-negative-reason","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 7 · Number system","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=47","standardMeta":{"jurisdiction":"OH","code":"7.NS.1","grade":7,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"subtract-negative-reason","coverageStatus":"Ready for teacher review","skillLabel":"Add and subtract rational numbers","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Compute (−6) × 3.","answers":["-18","-36","-17","-19"],"correct":0,"explanation":"Factors with unlike signs have a negative product.","topic":"Math","standard":"7.NS.2","mathGrade":7,"mathLevel":"practice","mathFormat":"signed-product","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 7 · Number system","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=48","standardMeta":{"jurisdiction":"OH","code":"7.NS.2","grade":7,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"signed-product","coverageStatus":"Ready for teacher review","skillLabel":"Multiply, divide and convert rationals","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Compute -14 ÷ (−7).","answers":["4","2","1","3"],"correct":1,"explanation":"Dividing values with the same sign gives a positive quotient.","topic":"Math","standard":"7.NS.2","mathGrade":7,"mathLevel":"practice","mathFormat":"signed-quotient","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 7 · Number system","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=48","standardMeta":{"jurisdiction":"OH","code":"7.NS.2","grade":7,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"signed-quotient","coverageStatus":"Ready for teacher review","skillLabel":"Multiply, divide and convert rationals","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"Write 8/8 as a decimal.","answers":["2","1","0.5","0"],"correct":1,"explanation":"Divide numerator by denominator.","topic":"Math","standard":"7.NS.2","mathGrade":7,"mathLevel":"practice","mathFormat":"fraction-to-decimal","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 7 · Number system","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=48","standardMeta":{"jurisdiction":"OH","code":"7.NS.2","grade":7,"version":"2017",