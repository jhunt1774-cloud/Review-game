{"version":1,"name":"Ohio Grade 7 · 7.NS unit review","difficulty":"advanced","pace":"practice","questions":[{"text":"-2 + -2 = ?","answers":["-4","-5","-3","-8"],"correct":0,"explanation":"Adding a negative moves left on a number line.","topic":"Math","standard":"7.NS.1","mathGrade":7,"mathLevel":"practice","mathFormat":"integer-sum","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 7 · Number system","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=47","standardMeta":{"jurisdiction":"OH","code":"7.NS.1","grade":7,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"integer-sum","coverageStatus":"Ready for teacher review","skillLabel":"Add and subtract rational numbers","contentSource":{"type":"prepared","label":"Saved generated practice"}}},{"text":"-7 − (−4) = ?","answers":["-4","-3","-6","-2"],"correct":1,"explanation":"Subtracting a negative adds its opposite.","topic":"Math","standard":"7.NS.1","mathGrade":7,"mathLevel":"practice","mathFormat":"subtract-negative","difficulty":"intermediate","generatorVersion":4,"origin":"Original Ohio middle-school practice","subject":"Grade 7 · Number system","source":"https://education.ohio.gov/getattachment/Topics/Learning-in-Ohio/Mathematics/Ohio-s-Learning-Standards-in-Mathematics/MATH-Standards-2017.pdf.aspx?lang=en-US#page=47","standardMeta":{"jurisdiction":"OH","code":"7.NS.1","grade":7,"version":"2017","sourceId":"oh-math2017","scope":"Partial skill practice; not full-standard assessment","review":"Teacher review required","authoring":"Original program content","format":"subtract-negative","coverageStatus":"Ready for teacher review","skillLabel":"Add and subtract rational numbers","contentSource":{"t